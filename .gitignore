# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Experiment caches
outputs/**/prepared_cache/

# Generated experiment outputs and large data artifacts
outputs/
external/baselines/
external/reference_repos/

# Cached reference PDFs (the docs/papers/README.md index IS tracked; PDFs are a
